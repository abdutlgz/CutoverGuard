{
 "datasets": [
  {
   "name": "retail_replay",
   "displayName": "Retail Replay",
   "queryLines": [
    "SELECT 'defective' scenario,CAST(absolute_account_delta_minor/100 AS DECIMAL(38,2)) absolute_difference_major,(SELECT count(*) FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_issues`) findings FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_totals` WHERE currency='GBP' UNION ALL SELECT 'corrected',CAST(absolute_account_delta_minor/100 AS DECIMAL(38,2)),(SELECT count(*) FROM `workspace`.`default`.`cutoverguard_0b5f1d4d1d5f4ca0_issues`) FROM `workspace`.`default`.`cutoverguard_0b5f1d4d1d5f4ca0_totals` WHERE currency='GBP'\n"
   ]
  },
  {
   "name": "retail_kpis",
   "displayName": "Retail Kpis",
   "queryLines": [
    "SELECT (SELECT count(*) FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_issues`) primary_findings,currency,CAST(source_minor/100 AS DECIMAL(38,2)) source_major,CAST(candidate_minor/100 AS DECIMAL(38,2)) candidate_major,CAST(net_delta_minor/100 AS DECIMAL(38,2)) net_delta_major,CAST(absolute_account_delta_minor/100 AS DECIMAL(38,2)) absolute_delta_major,CAST(affected_notional_minor/100 AS DECIMAL(38,2)) affected_major FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_totals` WHERE currency='GBP'\n"
   ]
  },
  {
   "name": "retail_findings",
   "displayName": "Retail Findings",
   "queryLines": [
    "SELECT check_id,type,key,field,source_value,candidate_value FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_issues`\n"
   ]
  },
  {
   "name": "retail_impacts",
   "displayName": "Retail Impacts",
   "queryLines": [
    "SELECT account_id,currency,CAST(source_minor/100 AS DECIMAL(38,2)) source_major,CAST(candidate_minor/100 AS DECIMAL(38,2)) candidate_major,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_impacts` WHERE currency='GBP'\n"
   ]
  },
  {
   "name": "retail_chart",
   "displayName": "Retail Chart",
   "queryLines": [
    "SELECT account_id label,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_impacts` WHERE currency='GBP' AND delta_minor<>0 UNION ALL SELECT 'Extract net' label,CAST(net_delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`cutoverguard_fafd9a2bdcc74b3b_totals` WHERE currency='GBP'\n"
   ]
  },
  {
   "name": "scale_kpis",
   "displayName": "Scale Kpis",
   "queryLines": [
    "SELECT source_rows orders,candidate_total-source_total total_difference_scaled,crosswalk_findings,order_findings wrong_owners,quarantined_rows FROM `workspace`.`cutoverguard_migration_bad`.gold_cutover_decision\n"
   ]
  },
  {
   "name": "scale_checks",
   "displayName": "Scale Checks",
   "queryLines": [
    "WITH d AS (SELECT * FROM `workspace`.`cutoverguard_migration_bad`.gold_cutover_decision), raw AS (\n",
    "SELECT 1 ordinal,'Row count' check_name,format_number(source_rows,0) source_value,format_number(candidate_rows,0) candidate_value,source_rows=candidate_rows AND source_rows=legacy_rows passed FROM d\n",
    "UNION ALL SELECT 2,'Total price units',format_number(CAST(source_total/100 AS DECIMAL(38,2)),2),format_number(CAST(candidate_total/100 AS DECIMAL(38,2)),2),source_total<=>candidate_total FROM d\n",
    "UNION ALL SELECT 3,'Quarantine','0 rows',concat(CAST(quarantined_rows AS STRING),' rows'),quarantined_rows=0 FROM d\n",
    "UNION ALL SELECT 4,'Crosswalk mapping','Expected customer',concat(CAST(crosswalk_findings AS STRING),' wrong mappings'),crosswalk_findings=0 FROM d\n",
    "UNION ALL SELECT 5,'Order ownership','Original owner',concat(CAST(order_findings AS STRING),' wrong-owner orders'),order_findings=0 FROM d\n",
    ") SELECT ordinal,check_name,source_value,candidate_value,CASE WHEN passed THEN '🟢 PASS' ELSE '🔴 BLOCKED' END result_label FROM raw ORDER BY ordinal\n"
   ]
  },
  {
   "name": "scale_effects",
   "displayName": "Scale Effects",
   "queryLines": [
    "SELECT account_id customer,CAST(delta_scaled_units/100 AS DECIMAL(38,2)) signed_price_units,CASE WHEN delta_scaled_units>0 THEN 'Over' ELSE 'Under' END direction FROM `workspace`.`cutoverguard_migration_bad`.gold_customer_effects WHERE delta_scaled_units<>0 ORDER BY delta_scaled_units DESC,account_id\n"
   ]
  },
  {
   "name": "scale_drilldown",
   "displayName": "Scale Drilldown",
   "queryLines": [
    "SELECT order_id order_key,original_owner,migrated_owner,CAST(original_amount/100 AS DECIMAL(38,2)) price_units,original_utc FROM `workspace`.`cutoverguard_migration_bad`.gold_order_issues ORDER BY original_amount DESC,order_id\n"
   ]
  },
  {
   "name": "pipeline_replay",
   "displayName": "Pipeline Replay",
   "queryLines": [
    "SELECT 'Defective migration' scenario,format_number(source_rows,0) source_rows,format_number(candidate_rows,0) candidate_rows,order_findings,crosswalk_findings,CAST((candidate_total-source_total)/100 AS DECIMAL(38,2)) net_price_difference,CASE status WHEN 'blocked' THEN '🔴 BLOCKED' ELSE status END status,'🔴 Gate FAILED · nothing promoted' promotion FROM `workspace`.`cutoverguard_migration_bad`.gold_cutover_decision UNION ALL SELECT 'Corrected migration',format_number(source_rows,0),format_number(candidate_rows,0),order_findings,crosswalk_findings,CAST((candidate_total-source_total)/100 AS DECIMAL(38,2)),CASE status WHEN 'ready' THEN '🟢 READY for human review' ELSE status END,'🟢 Gate PASSED · '||format_number((SELECT count(*) FROM `workspace`.`cutoverguard_promotion_fixed`.promoted_orders),0)||' rows promoted' FROM `workspace`.`cutoverguard_migration_fixed`.gold_cutover_decision\n"
   ]
  }
 ],
