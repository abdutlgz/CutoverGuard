{
  "datasets": [
    {
      "name": "scale_kpis",
      "displayName": "Scale Kpis",
      "queryLines": [
        "WITH paired AS (SELECT s.row_count source_count,c.row_count candidate_count,s.total_scaled_units source_total,c.total_scaled_units candidate_total,s.owner_checksum_unsigned64 source_owner,c.owner_checksum_unsigned64 candidate_owner,s.order_checksum_unsigned64 source_order,c.order_checksum_unsigned64 candidate_order FROM `workspace`.`default`.`YOUR_TPCH_RUN_metrics` s CROSS JOIN `workspace`.`default`.`YOUR_TPCH_RUN_metrics` c WHERE s.side='source' AND c.side='candidate') SELECT CAST(source_count AS BIGINT) orders,CAST(candidate_total AS DECIMAL(38,0))-CAST(source_total AS DECIMAL(38,0)) total_difference_scaled,CAST(source_owner<>candidate_owner AS INT)+CAST(source_order<>candidate_order AS INT) checksum_mismatches,(SELECT count(*) FROM `workspace`.`default`.`YOUR_TPCH_RUN_issues`) wrong_owners,CAST(59.8146045024041089 AS DOUBLE) recorded_query_seconds FROM paired\n"
      ]
    },
    {
      "name": "scale_checks",
      "displayName": "Scale Checks",
      "queryLines": [
        "WITH paired AS (SELECT s.row_count source_count,c.row_count candidate_count,s.total_scaled_units source_total,c.total_scaled_units candidate_total,s.owner_checksum_unsigned64 source_owner,c.owner_checksum_unsigned64 candidate_owner,s.order_checksum_unsigned64 source_order,c.order_checksum_unsigned64 candidate_order FROM `workspace`.`default`.`YOUR_TPCH_RUN_metrics` s CROSS JOIN `workspace`.`default`.`YOUR_TPCH_RUN_metrics` c WHERE s.side='source' AND c.side='candidate'), daily AS (SELECT order_date,sum(amount_scaled_units) amount FROM `workspace`.`default`.`YOUR_TPCH_RUN_source` GROUP BY order_date), candidate_daily AS (SELECT order_date,sum(amount_scaled_units) amount FROM `workspace`.`default`.`YOUR_TPCH_RUN_candidate` GROUP BY order_date), daily_diff AS (SELECT count(*) n FROM daily s FULL OUTER JOIN candidate_daily c ON s.order_date=c.order_date WHERE s.order_date IS NULL OR c.order_date IS NULL OR NOT(s.amount<=>c.amount)), raw AS (\nSELECT 1 ordinal,'Row count' check_name,source_count source_value,candidate_count candidate_value,source_count=candidate_count passed FROM paired\nUNION ALL SELECT 2,'Total price units',CAST(CAST(CAST(source_total AS DECIMAL(38,0))/100 AS DECIMAL(38,2)) AS STRING),CAST(CAST(CAST(candidate_total AS DECIMAL(38,0))/100 AS DECIMAL(38,2)) AS STRING),source_total=candidate_total FROM paired\nUNION ALL SELECT 3,'Owner-ID checksum',source_owner,candidate_owner,source_owner=candidate_owner FROM paired\nUNION ALL SELECT 4,'Order-key checksum',source_order,candidate_order,source_order=candidate_order FROM paired\nUNION ALL SELECT 5,'Daily price totals','0 mismatched days',concat(CAST(n AS STRING),' mismatched days'),n=0 FROM daily_diff\nUNION ALL SELECT 6,'CutoverGuard ownership','\u2014',concat(CAST(count(*) AS STRING),' wrong-owner rows'),count(*)=0 FROM `workspace`.`default`.`YOUR_TPCH_RUN_issues`)\nSELECT ordinal,check_name,source_value,candidate_value,CASE WHEN passed THEN '\ud83d\udfe2 PASS' WHEN ordinal=6 THEN '\ud83d\udd34 BLOCKED' ELSE '\ud83d\udd34 FAIL' END result_label FROM raw ORDER BY ordinal\n"
      ]
    },
    {
      "name": "scale_effects",
      "displayName": "Scale Effects",
      "queryLines": [
        "SELECT account_id customer,CAST(delta_units/100 AS DECIMAL(38,2)) signed_price_units,CASE WHEN delta_units>0 THEN 'Increase' ELSE 'Decrease' END direction FROM `workspace`.`default`.`YOUR_TPCH_RUN_impacts` WHERE delta_units<>0 ORDER BY CAST(delta_units AS DECIMAL(38,0)) DESC,account_id\n"
      ]
    },
    {
      "name": "scale_drilldown",
      "displayName": "Scale Drilldown",
      "queryLines": [
        "SELECT order_id order_key,source_account_id original_owner,candidate_account_id migrated_owner,CAST(CAST(source_amount AS DECIMAL(38,0))/100 AS DECIMAL(38,2)) price_units,source_date order_date FROM `workspace`.`default`.`YOUR_TPCH_RUN_issues` ORDER BY CAST(source_amount AS DECIMAL(38,0)) DESC,order_id\n"
      ]
    },
    {
      "name": "retail_replay",
      "displayName": "Retail Replay",
      "queryLines": [
        "SELECT 'defective' scenario,CAST(absolute_account_delta_minor/100 AS DECIMAL(38,2)) absolute_difference_major,(SELECT count(*) FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_issues`) findings FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_totals` WHERE currency='GBP' UNION ALL SELECT 'corrected',CAST(absolute_account_delta_minor/100 AS DECIMAL(38,2)),(SELECT count(*) FROM `workspace`.`default`.`YOUR_RETAIL_CORRECTED_issues`) FROM `workspace`.`default`.`YOUR_RETAIL_CORRECTED_totals` WHERE currency='GBP'\n"
      ]
    },
    {
      "name": "retail_kpis",
      "displayName": "Retail Kpis",
      "queryLines": [
        "SELECT (SELECT count(*) FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_issues`) primary_findings,currency,CAST(source_minor/100 AS DECIMAL(38,2)) source_major,CAST(candidate_minor/100 AS DECIMAL(38,2)) candidate_major,CAST(net_delta_minor/100 AS DECIMAL(38,2)) net_delta_major,CAST(absolute_account_delta_minor/100 AS DECIMAL(38,2)) absolute_delta_major,CAST(affected_notional_minor/100 AS DECIMAL(38,2)) affected_major FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_totals` WHERE currency='GBP'\n"
      ]
    },
    {
      "name": "retail_findings",
      "displayName": "Retail Findings",
      "queryLines": [
        "SELECT check_id,type,key,field,source_value,candidate_value FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_issues`\n"
      ]
    },
    {
      "name": "retail_impacts",
      "displayName": "Retail Impacts",
      "queryLines": [
        "SELECT account_id,currency,CAST(source_minor/100 AS DECIMAL(38,2)) source_major,CAST(candidate_minor/100 AS DECIMAL(38,2)) candidate_major,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_impacts` WHERE currency='GBP'\n"
      ]
    },
    {
      "name": "retail_chart",
      "displayName": "Retail Chart",
      "queryLines": [
        "SELECT account_id label,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_impacts` WHERE currency='GBP' AND delta_minor<>0 UNION ALL SELECT 'Extract net' label,CAST(net_delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`YOUR_RETAIL_DEFECTIVE_totals` WHERE currency='GBP'\n"
      ]
    }
  ],
