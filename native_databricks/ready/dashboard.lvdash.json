{
  "datasets": [
    {
      "name": "review_summary",
      "displayName": "Review Summary",
      "queryLines": [
        "SELECT 'defective' scenario, currency, source_minor, candidate_minor, net_delta_minor, absolute_account_delta_minor, affected_notional_minor, (SELECT count(*) FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_issues`) primary_findings FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_totals`\nUNION ALL\nSELECT 'fixed' scenario, currency, source_minor, candidate_minor, net_delta_minor, absolute_account_delta_minor, affected_notional_minor, (SELECT count(*) FROM `workspace`.`default`.`cutoverguard_3c068b368cca461b_issues`) primary_findings FROM `workspace`.`default`.`cutoverguard_3c068b368cca461b_totals`\n"
      ]
    },
    {
      "name": "ownership_findings",
      "displayName": "Ownership Findings",
      "queryLines": [
        "SELECT 'defective' scenario, check_id,type,key,field,source_value,candidate_value FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_issues`\nUNION ALL\nSELECT 'fixed' scenario, check_id,type,key,field,source_value,candidate_value FROM `workspace`.`default`.`cutoverguard_3c068b368cca461b_issues`\n"
      ]
    },
    {
      "name": "account_effects",
      "displayName": "Account Effects",
      "queryLines": [
        "SELECT 'defective' scenario, account_id,currency,source_minor,candidate_minor,delta_minor,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_impacts`\nUNION ALL\nSELECT 'fixed' scenario, account_id,currency,source_minor,candidate_minor,delta_minor,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major FROM `workspace`.`default`.`cutoverguard_3c068b368cca461b_impacts`\n"
      ]
    },
    {
      "name": "zero_net_chart",
      "displayName": "Zero Net Chart",
      "queryLines": [
        "SELECT 'defective' scenario, account_id label,currency,delta_minor,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major,'Account allocation difference' measure FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_impacts` UNION ALL SELECT 'defective' scenario,'Firm net' label,currency,net_delta_minor delta_minor,CAST(net_delta_minor/100 AS DECIMAL(38,2)) delta_major,'Firm net difference' measure FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_totals`\nUNION ALL\nSELECT 'fixed' scenario, account_id label,currency,delta_minor,CAST(delta_minor/100 AS DECIMAL(38,2)) delta_major,'Account allocation difference' measure FROM `workspace`.`default`.`cutoverguard_3c068b368cca461b_impacts` UNION ALL SELECT 'fixed' scenario,'Firm net' label,currency,net_delta_minor delta_minor,CAST(net_delta_minor/100 AS DECIMAL(38,2)) delta_major,'Firm net difference' measure FROM `workspace`.`default`.`cutoverguard_3c068b368cca461b_totals`\n"
      ]
    },
    {
      "name": "defective_kpis",
      "displayName": "Defective Kpis",
      "queryLines": [
        "SELECT (SELECT count(*) FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_issues`) primary_findings,CAST(net_delta_minor/100 AS DECIMAL(38,2)) net_delta_usd,CAST(absolute_account_delta_minor/100 AS DECIMAL(38,2)) absolute_account_delta_usd,CAST(affected_notional_minor/100 AS DECIMAL(38,2)) affected_notional_usd FROM `workspace`.`default`.`cutoverguard_222947f1bcdd4351_totals` WHERE currency='USD'\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "review",
      "displayName": "Migration review",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "story",
            "multilineTextboxSpec": {
              "lines": [
                "# CutoverGuard\n",
                "\n",
                "**Same total. Different owner.** Synthetic migration snapshots: two ownership breaks, opposite account effects, zero firm net. Corrected replay restores parity. Differences and affected notional are not losses."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_primary_findings",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "defective_kpis",
                  "fields": [
                    {
                      "name": "primary_findings",
                      "expression": "`primary_findings`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "primary_findings",
                  "displayName": "Ownership breaks"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Ownership breaks"
              }
